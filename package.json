{
  "name": "oarly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/setup-dev-env.mjs && next dev",
    "build": "node scripts/deploy-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oarly_test vitest run --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-dev.ts",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate --config ./src/auth.ts --output ./src/db/schema/auth.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": "eslint --fix --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@hookform/resolvers": "^5.7.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "negotiator": "^1.0.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.1",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  }
}
