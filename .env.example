# Database (Neon pooled for the app; unpooled/direct for migrations)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/oarly?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/oarly?sslmode=require"

# Auth
BETTER_AUTH_SECRET="run: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# COOKIE_DOMAIN=".oarly.sbs"   # leave unset locally
# TRUSTED_ORIGINS="https://oarly.sbs,https://*.oarly.sbs"
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Local development ---
# Subdomains on localhost, two options (no /etc/hosts edit needed):
#   1. *.localhost  -> open http://demo.localhost:3000  (Chrome/Edge/Firefox; NOT Safari)
#      keep APP_URL="http://localhost:3000"
#   2. lvh.me        -> open http://demo.lvh.me:3000     (any browser; needs DNS)
#      set  APP_URL="http://lvh.me:3000"
# APP_URL is the apex origin (protocol + host + port); the app derives the root
# domain and every club/apex URL from it.
#
# Dev database (docker compose up postgres-dev), then migrate + seed:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5434/oarly_dev"
#   pnpm db:migrate && pnpm db:seed   # seeds an active club at slug 'demo'
#
# NOTE on db:migrate. drizzle-kit prefers DATABASE_URL_UNPOOLED over DATABASE_URL
# (production DDL must bypass PgBouncer). So if your env file carries BOTH a localhost
# DATABASE_URL and a cloud DATABASE_URL_UNPOOLED, the cloud one wins and you would
# migrate the cloud database. `pnpm db:migrate` now refuses any non-localhost host and
# tells you so. To target local while a cloud unpooled URL is present, blank it:
#   DATABASE_URL_UNPOOLED= DATABASE_URL="postgresql://postgres:postgres@localhost:5434/oarly_dev" pnpm db:migrate
# Production migrates itself during the Vercel production build (scripts/deploy-migrate.mjs);
# migrating it by hand needs a deliberate ALLOW_REMOTE_MIGRATE=1.

# Google OAuth (optional locally)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional locally — logs to console when unset)
RESEND_API_KEY=""
EMAIL_FROM="Oarly <no-reply@oarly.sbs>"

# Rate limiting (optional locally — in-memory when unset).
# In prod these are provisioned automatically by the Vercel Upstash/KV integration
# (use the write token KV_REST_API_TOKEN, not KV_REST_API_READ_ONLY_TOKEN; the
# rediss:// KV_URL/REDIS_URL are for the TCP client and are unused here).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
